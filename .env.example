APP_ENV=development
DATABASE_URL=sqlite:///./legalgrowth.db
# Execute python -m app.cli init para criar .env com credenciais locais aleatorias.
ADMIN_PASSWORD=
VIEWER_PASSWORD=
SCHEDULER_ENABLED=false
REPORT_DAY=mon
REPORT_HOUR=9
REPORT_MINUTE=0
TIMEZONE=America/Sao_Paulo
# Opcoes legadas: conexoes atuais sao configuradas pelo painel.
AI_PROVIDER=none
AI_API_KEY=
AI_MAX_TOKENS=500
AI_MONTHLY_LIMIT_BRL=60
# A chave da OpenAI agora e conectada pelo painel, nao por AI_API_KEY.
# Em Docker, configure AI_ENCRYPTION_KEY com uma chave Fernet. Nunca versionar.
AI_ENCRYPTION_KEY=
# Chave Fernet diferente da chave de credenciais. Obrigatoria no Compose.
# No desenvolvimento, usa .secrets/client-data.key quando nao preenchida.
# Preserve a chave existente; trocar sem recifrar impede recuperar nomes locais.
DATA_ENCRYPTION_KEY=
